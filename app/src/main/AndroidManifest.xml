<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup: nothing of the app is backed up; mail is on the server and the credentials
         must not leave the device.
         enableOnBackInvokedCallback: the predictive Back gesture plays the kit's transitions. -->
    <application
        android:name=".DeskMailApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeskMail">
        <!-- The activity as desktop-kit's README defines it: resizeableActivity and configChanges let
             DeX resize the window without restarting the activity, adjustResize ends the content
             above the on-screen keyboard. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|fontScale"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Android 15+: the system's window menus (DeX, the taskbar) offer "New window" -->
            <property
                android:name="android.window.PROPERTY_SUPPORTS_MULTI_INSTANCE_SYSTEM_UI"
                android:value="true" />
        </activity>
    </application>
</manifest>
