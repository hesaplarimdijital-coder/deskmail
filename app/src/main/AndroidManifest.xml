<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The mail servers of the user's accounts, and the provider database when an account is added.
         Nothing else: no analytics, no server of the app's own. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- New mail is told of with a notification, once the user has allowed it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- allowBackup: nothing of the app is backed up; mail is on the server and the credentials
         must not leave the device.
         enableOnBackInvokedCallback: the predictive Back gesture plays the kit's transitions. -->
    <application
        android:name=".DeskMailApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeskMail">
        <!-- The activity as desktop-kit's README defines it: resizeableActivity and configChanges let
             DeX resize the window without restarting the activity, adjustResize ends the content
             above the on-screen keyboard. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|fontScale"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Android 15+: the system's window menus (DeX, the taskbar) offer "New window" -->
            <property
                android:name="android.window.PROPERTY_SUPPORTS_MULTI_INSTANCE_SYSTEM_UI"
                android:value="true" />
        </activity>

        <!-- WorkManager (which sends what waits in the outbox, and looks for new mail while no
             window is open) is set up when it is first asked for, by the application class, not
             at every start of the process. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- The buttons of a new-mail notification ("Read", "Archive", "Delete"). Only the app's own
             notifications reach it. -->
        <receiver
            android:name=".notify.NotifyActionReceiver"
            android:exported="false" />

        <!-- Hands a file of the app's to another app for one read: the log, when it is shared. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
