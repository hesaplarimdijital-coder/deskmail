<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only what the window shows before desktop-kit draws; every colour after that is the kit's. -->
    <style name="Theme.DeskMail" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- A WebView draws a light or a dark page by the theme of the context it is created with
         (isLightTheme), not by the system's night mode. The reader wraps its context in one of
         these, so a message follows the theme chosen in the app. -->
    <style name="DeskMailWebLight">
        <item name="android:isLightTheme">true</item>
    </style>

    <style name="DeskMailWebDark">
        <item name="android:isLightTheme">false</item>
    </style>
</resources>
